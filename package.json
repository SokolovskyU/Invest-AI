{
  "name": "tbank-invest-pet",
  "version": "0.1.0",
  "private": true,
  "description": "T-Bank Invest API pet project",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p tsconfig.backend.json --pretty false",
    "typecheck:frontend": "tsc -p web/tsconfig.json --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"README.md\" \"docs/**/*.{md,yaml,json}\" \"src/app.ts\" \"src/auth/**/*.ts\" \"src/middleware/**/*.ts\" \"src/platform/**/*.ts\" \"src/routes/**/*.ts\" \"tests-vitest/**/*.ts\" \"web/src/App.tsx\" \"web/src/main.tsx\" \"web/src/api/**/*.ts\" \"web/index.html\" \"web/public/manifest.webmanifest\" \"web/public/sw.js\" \"web/public/offline.html\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"README.md\" \"docs/**/*.{md,yaml,json}\" \"src/app.ts\" \"src/auth/**/*.ts\" \"src/middleware/**/*.ts\" \"src/platform/**/*.ts\" \"src/routes/**/*.ts\" \"tests-vitest/**/*.ts\" \"web/src/App.tsx\" \"web/src/main.tsx\" \"web/src/api/**/*.ts\" \"web/index.html\" \"web/public/manifest.webmanifest\" \"web/public/sw.js\" \"web/public/offline.html\" \".github/workflows/*.yml\"",
    "api:generate": "openapi-typescript docs/openapi.yaml -o web/src/api/generated.ts",
    "web:sync-legacy": "tsx scripts/export-legacy-pages.ts",
    "web:dev": "npm run web:sync-legacy && npm --prefix web run dev",
    "web:dev:host": "npm run web:sync-legacy && npm --prefix web run dev -- --host 127.0.0.1 --port 5173",
    "web:build": "npm run web:sync-legacy && npm --prefix web run build",
    "web:preview": "npm --prefix web run preview",
    "start": "node dist/server.js",
    "cli": "tsx src/index.ts",
    "check:project-control": "tsx scripts/check-project-control.ts",
    "check:encoding": "tsx scripts/check-encoding.ts",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "test:runtime": "npx tsx tests/utils.test.ts && npx tsx tests/api.analytics.test.ts && npx tsx tests/api.metrics.test.ts && npx tsx tests/grpcHelpers.test.ts",
    "test:ci": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run web:build && npm run test && npm run test:vitest && npm run test:e2e",
    "test": "npm run check:project-control && npm run check:encoding && npm run test:runtime"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.8.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "qs": "^6.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  }
}
