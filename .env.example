# T-Invest API token
TINVEST_TOKEN=

# Optional application name (will be sent as x-app-name header)
TINVEST_APP_NAME=invest-pet

# Optional override (prod default). For sandbox use:
# sandbox-invest-public-api.tbank.ru:443
TINVEST_ENDPOINT=invest-public-api.tbank.ru:443

# If your network injects a self-signed TLS cert, set to true (dev only)
# TINVEST_INSECURE=true

# Web server port
PORT=3000

# UI serving mode: auto | react | legacy
# auto (default): React when web/dist exists, otherwise legacy.
UI_MODE=auto

# Optional legacy UI fallback (compatibility mode):
# LEGACY_UI=true

# Session cookie settings for browser UI auth (HttpOnly cookie)
# TINVEST_SESSION_COOKIE_NAME=invest_sid
# TINVEST_SESSION_TTL_HOURS=12
# TINVEST_SESSION_SECURE=false

# Feature flags (optional)
# FEATURE_NATIVE_UI_DEFAULT=false
# FEATURE_SESSION_AUTH_REQUIRED=false
# FEATURE_BACKGROUND_ANALYTICS_JOBS=true
# FEATURE_REPORTS_EXPORT_ENABLED=true
# FEATURE_ALERTS_ENABLED=true
# FEATURE_RBAC_ENABLED=false
